environments:
  dev:
    values:
      - version: 1.0.1
---

repositories:
  - name: soultrace
    url: https://charts.soultrace.net

releases:
  - name: freescout
    namespace: {{ .Namespace }}
    chart: soultrace/freescout
    version: {{ .Values.version }}
    values:
      - common/values.yaml
      - env/{{ .Environment.Name }}/values.yaml
    secrets:
      - env/{{ .Environment.Name }}/secrets.enc.yaml
    strategicMergePatches:
      - common/patch.yaml
      - common/patch2.yaml
